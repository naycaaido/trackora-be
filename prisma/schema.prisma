// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleStatus {
  healthy
  warning
  critical
}

enum RiskLevel {
  low
  medium
  high
}

enum SeverityLevel {
  low
  medium
  high
  critical
}

enum AlertType {
  critical_risk
  maintenance_due
  repeated_issue
}

model Vehicle {
  id                  String                 @id
  vehicleCode         String                 @unique @map("vehicle_code")
  name                String
  type                String
  location            String
  status              VehicleStatus          @default(healthy)
  healthScore         Int                    @default(100) @map("health_score")
  downtimeRisk        RiskLevel              @default(low) @map("downtime_risk")
  lastMaintenanceDate DateTime?              @map("last_maintenance_date") @db.Date
  nextMaintenanceDate DateTime?              @map("next_maintenance_date") @db.Date
  mileage             Int                    @default(0)
  operatingHours      Int                    @default(0) @map("operating_hours")
  issueCount          Int                    @default(0) @map("issue_count")
  recommendation      String?
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  maintenanceReports  MaintenanceReport[]
  alerts              Alert[]
  repeatedIssues      VehicleRepeatedIssue[]

  @@index([status], map: "idx_vehicles_status")
  @@index([type], map: "idx_vehicles_type")
  @@index([downtimeRisk], map: "idx_vehicles_downtime_risk")
  @@map("vehicles")
}

model MaintenanceReport {
  id          String        @id
  vehicleId   String        @map("vehicle_id")
  date        DateTime      @db.Date
  component   String
  issue       String
  severity    SeverityLevel
  technician  String
  note        String?
  actionTaken String?       @map("action_taken")
  createdAt   DateTime      @default(now()) @map("created_at")
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date(sort: Desc)], map: "idx_reports_vehicle_date")
  @@map("maintenance_reports")
}

model Alert {
  id                       String    @id
  vehicleId                String    @map("vehicle_id")
  type                     AlertType
  riskLevel                RiskLevel @map("risk_level")
  message                  String
  predictedNextMaintenance DateTime? @map("predicted_next_maintenance") @db.Date
  recommendation           String?
  daysUntilMaintenance     Int?      @map("days_until_maintenance")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  vehicle                  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([isActive, riskLevel], map: "idx_alerts_active_risk")
  @@map("alerts")
}

model VehicleRepeatedIssue {
  vehicleId String  @map("vehicle_id")
  issue     String
  frequency Int     @default(1)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([vehicleId, issue])
  @@map("vehicle_repeated_issues")
}
