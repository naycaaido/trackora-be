generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum VehicleStatus {
  healthy
  warning
  critical
}

enum RiskLevel {
  low
  medium
  high
}

enum SeverityLevel {
  low
  medium
  high
  critical
}

enum AlertType {
  critical_risk
  maintenance_due
  repeated_issue
}

enum UserRole {
  admin
  manager
  technician
  viewer
}

// ==================== AUTH MODELS ====================

model User {
  id           String    @id
  email        String    @unique
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(viewer)
  fullName     String?   @map("full_name")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model RefreshToken {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  family    String
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([token], map: "idx_refresh_tokens_token")
  @@index([family], map: "idx_refresh_tokens_family")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id
  email     String
  token     String   @unique
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token], map: "idx_password_reset_token")
  @@index([email], map: "idx_password_reset_email")
  @@map("password_reset_tokens")
}

// ==================== VEHICLE MODELS ====================

model Vehicle {
  id                  String                 @id
  vehicleCode         String                 @unique @map("vehicle_code")
  name                String
  type                String
  location            String
  status              VehicleStatus          @default(healthy)
  healthScore         Int                    @default(100) @map("health_score")
  downtimeRisk        RiskLevel              @default(low) @map("downtime_risk")
  lastMaintenanceDate DateTime?              @map("last_maintenance_date") @db.Date
  nextMaintenanceDate DateTime?              @map("next_maintenance_date") @db.Date
  mileage             Int                    @default(0)
  operatingHours      Int                    @default(0) @map("operating_hours")
  issueCount          Int                    @default(0) @map("issue_count")
  recommendation      String?
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  maintenanceReports  MaintenanceReport[]
  alerts              Alert[]
  repeatedIssues      VehicleRepeatedIssue[]

  @@index([status], map: "idx_vehicles_status")
  @@index([type], map: "idx_vehicles_type")
  @@index([downtimeRisk], map: "idx_vehicles_downtime_risk")
  @@map("vehicles")
}

model MaintenanceReport {
  id          String        @id
  vehicleId   String        @map("vehicle_id")
  date        DateTime      @db.Date
  component   String
  issue       String
  severity    SeverityLevel
  technician  String
  note        String?
  actionTaken String?       @map("action_taken")
  createdAt   DateTime      @default(now()) @map("created_at")
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date(sort: Desc)], map: "idx_reports_vehicle_date")
  @@map("maintenance_reports")
}

model Alert {
  id                       String    @id
  vehicleId                String    @map("vehicle_id")
  type                     AlertType
  riskLevel                RiskLevel @map("risk_level")
  message                  String
  predictedNextMaintenance DateTime? @map("predicted_next_maintenance") @db.Date
  recommendation           String?
  daysUntilMaintenance     Int?      @map("days_until_maintenance")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  vehicle                  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([isActive, riskLevel], map: "idx_alerts_active_risk")
  @@map("alerts")
}

model VehicleRepeatedIssue {
  vehicleId String  @map("vehicle_id")
  issue     String
  frequency Int     @default(1)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([vehicleId, issue])
  @@map("vehicle_repeated_issues")
}
